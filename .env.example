APP_NAME="TradeWithCuso"
APP_ENV=production
APP_KEY=
# Never true on a live server: it prints stack traces, file paths and
# configuration to anyone who triggers an error.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradewithcuso
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@tradewithcuso.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# Tokens for traders and admins expire after this many minutes (30 days).
SANCTUM_TOKEN_MINUTES=43200

# First owner account, created by AdminSeeder.
ADMIN_NAME="Cuso"
ADMIN_EMAIL=admin@tradewithcuso.com
# Set a long, unique password before seeding. The seeder refuses to run
# outside local development without one.
ADMIN_PASSWORD=

# Where admin alerts (payments, reported bank transfers) are sent.
NOTIFY_EMAIL=hello@tradewithcuso.com

# Paystack. Test keys while building, live keys in production.
# Dashboard -> Settings -> API Keys & Webhooks. Webhook URL:
# https://<api-domain>/api/paystack/webhook
# Leave blank to take bank transfers only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
